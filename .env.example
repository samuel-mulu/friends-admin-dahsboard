# =============================================================================
# Friends Bingo Mobile - Environment Configuration (.env.example)
# =============================================================================
# Copy this file to .env and adjust values for your development environment:
#   cp .env.example .env
#
# Resolution order in Flutter:
#   1. Compile-time defines: --dart-define / --dart-define-from-file=.env
#   2. Runtime asset: .env file bundled via flutter_dotenv
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API & WebSocket URLs (REQUIRED)
# -----------------------------------------------------------------------------
# Choose the URL that matches your development environment:
#
# Option A - Android Emulator:
#   API_BASE_URL=http://10.0.2.2:4000
#   SOCKET_URL=http://10.0.2.2:4000
#
# Option B - Physical Android Device via USB (with 'adb reverse tcp:4000 tcp:4000'):
#   API_BASE_URL=http://127.0.0.1:4000
#   SOCKET_URL=http://127.0.0.1:4000
#
# Option C - Physical Device over Wi-Fi / LAN:
#   API_BASE_URL=http://192.168.1.100:4000
#   SOCKET_URL=http://192.168.1.100:4000
#
# Option D - Flutter Web / Windows Desktop:
#   API_BASE_URL=http://localhost:4000
#   SOCKET_URL=http://localhost:4000
#
# Option E - Production:
#   API_BASE_URL=https://api.friendsbingo.com
#   SOCKET_URL=https://api.friendsbingo.com
# -----------------------------------------------------------------------------
API_BASE_URL=http://10.0.2.2:4000
SOCKET_URL=http://10.0.2.2:4000

# -----------------------------------------------------------------------------
# Debug Tracing Toggles (Optional, default: false)
# -----------------------------------------------------------------------------
REALTIME_DEBUG=true
# Live play cartela scroll / rebuild console tracing ([CartelaScroll] logs)
CARTELA_SCROLL_DEBUG=false
CHAIN_DEBUG=false
BIG_GAME_DEBUG=false
DEBUG=false
TELEBIRR_DEPOSIT_DEBUG=false
